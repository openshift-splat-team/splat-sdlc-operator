# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# ── LLM provider ──────────────────────────────────────────────────────────────
# LiteLLM routes based on the model string prefix. Switch providers by changing
# these two lines — no code changes required.
#
# OpenAI:
#   LITELLM_MODEL=openai/gpt-4o
#   LLM_API_KEY=sk-...
#
# Anthropic:
#   LITELLM_MODEL=anthropic/claude-sonnet-4-6
#   LLM_API_KEY=sk-ant-...
#
# OpenAI-compatible local server (MLX, LM Studio, vLLM, llama.cpp, etc.):
#   LiteLLM strips the "openai/" prefix and sends the rest as the model name.
#   If the server uses HuggingFace-style IDs (org/model), include the full path:
#   LITELLM_MODEL=openai/mlx-community/Qwen3.5-9B-MLX-4bit
#   LLM_API_KEY=any           ← required; local servers ignore the value
#   LLM_API_BASE=http://192.168.x.x:8000/v1  ← must include /v1
#   Verify the exact model name with: curl http://192.168.x.x:8000/v1/models
#
# Ollama deployed in Kind — workers running locally (make dev-*):
#   LLM_API_BASE=http://localhost:11434   ← Kind maps this port to the ollama Service
#
# Ollama deployed in Kind — workers running in-cluster (make deploy):
#   LLM_API_BASE is set directly in the Deployment manifests; no need to set it here.
#   Value used: http://ollama.sdlc.svc.cluster.local:11434
#
# Recommended Ollama models for CPU-only with AVX-512 (pull with: ollama pull <model>):
#   ollama/qwen2.5:7b-instruct-q4_K_M   ← best overall; strong structured JSON output, good for this workload
#   ollama/mistral:7b-instruct-q4_K_M   ← solid fallback; fast on AVX-512, reliable instruction following
#   ollama/llama3.2:3b-instruct-q4_K_M  ← fastest; use if 7B is too slow (~2-3 tok/s on most CPUs)
#   ollama/phi3.5:mini-instruct-q4_K_M  ← 3.8B from Microsoft; punches above its weight for reasoning tasks
#
# Azure OpenAI:
#   LITELLM_MODEL=azure/gpt-4o
#   LLM_API_KEY=...
#   LLM_API_BASE=https://yourdeployment.openai.azure.com
#
# Google Vertex AI:
#   LITELLM_MODEL=vertex_ai/gemini-2.5-pro
#   VERTEX_PROJECT=my-gcp-project
#   VERTEX_LOCATION=us-central1
#   GOOGLE_APPLICATION_CREDENTIALS_FILE=/path/to/service-account.json
LITELLM_MODEL=ollama/qwen2.5:7b-instruct-q4_K_M
# LLM_API_KEY=        # not required for Ollama
LLM_API_BASE=http://localhost:11434

# ── Per-agent LLM overrides (optional) ───────────────────────────────────────
# Point to a YAML file that lets you route individual agents to different
# models/providers. See llm_config.yaml for a fully commented example.
# LLM_CONFIG_PATH=./llm_config.yaml

# full_sdlc trigger defaults (scripts/trigger.py)
# STAGING_GITHUB_ORG is also used here (see GitHub section below)
# TARGET_OCP_VERSION=4.17
# ENHANCEMENT_REPO=openshift-splat-team/enhancements

# GitHub (github-agent, enhancement-agent, openshift-agent)
# To use real GitHub (default):
GITHUB_TOKEN=ghp_...
STAGING_GITHUB_ORG=rvanderp3      # forks of upstream repos are created here
# GITHUB_BASE_URL=https://api.github.com  # default; omit for real GitHub
#
# To use local Gitea simulator instead of real GitHub:
#   1. Run: make dev   (starts Gitea + runs gitea-init)
#   2. Run: make gitea-token  (prints the generated API token)
#   3. Uncomment and fill in:
# GITHUB_TOKEN=<paste token from make gitea-token>
# GITHUB_BASE_URL=http://localhost:3000/api/v1
# GITHUB_BOT_USER=gitea               # username the bot posts as; its comments are excluded from reviewer feedback
# STAGING_GITHUB_ORG=staging   # must match STAGING_GITHUB_ORG used when gitea-init ran

# Jira (requirements-agent, jira-agent)
# To use real Jira:
JIRA_URL=https://yourorg.atlassian.net
JIRA_USER=user@example.com
JIRA_TOKEN=...
#
# To use the local Jira simulator instead:
#   1. Run: make dev   (starts jira-simulator automatically)
#   2. Uncomment and fill in:
# JIRA_URL=http://localhost:8080  # host-side only; compose.yaml overrides to http://jira-simulator:8080 for containers
# JIRA_USER=admin        # any value accepted
# JIRA_TOKEN=any         # any value accepted
# JIRA_PROJECT_KEY=SDLC  # required — issue keys will be SDLC-1, SDLC-2, etc.

# OpenShift dep-tree MCP server (openshift-agent)
# SSE transport (preferred — used by compose.yaml with the dep-tree container):
#   MCP_SERVER_URL=http://localhost:8000/sse
#
# Stdio transport (fallback — spawns a subprocess directly):
#   MCP_SERVER_SCRIPT=/absolute/path/to/openshift-dep-tree/mcp_server.py
#   MCP_DATA_DIR=       # optional — override data file location

# S3-compatible object store (RustFS)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
MINIO_BUCKET=sdlc-artifacts
MINIO_SECURE=false
